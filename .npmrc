# Supply-chain cooldown: never install a package version published less than
# 7 days ago. npm picks the newest release that clears the window, giving
# security tooling time to catch malicious publishes before they land here.
# Requires npm >= 11.10.0 (older npm silently ignores this key).
# Value is in days. Do not combine with `npm --before`.
min-release-age=7
