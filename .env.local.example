# Firebase Configuration
# Get these values from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# OneSignal (web push notifications)
# App ID from OneSignal dashboard > Settings > Keys & IDs. Safe to expose (public).
NEXT_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id

# Sentry (error monitoring). DSN is public/safe to expose. A default is baked
# into the config, so this is only needed to override it.
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
# Optional, CI-only: enables source-map upload for readable stack traces.
# SENTRY_ORG=your_org_slug
# SENTRY_PROJECT=your_project_slug
# SENTRY_AUTH_TOKEN=your_auth_token   (secret — set in GitHub Actions, not here)

# Setup Instructions:
# 1. Go to Firebase Console (https://console.firebase.google.com)
# 2. Create a new project or select existing
# 3. Enable Authentication > Email/Password provider
# 4. Create Firestore Database
# 5. Copy this file to .env.local and fill in your values
# 6. Deploy firestore.rules to your Firebase project
